@host = http://localhost:4000
@email = nino@batumipalace.ge
@password = not-a-real-password
@token = paste-a-room-token

### health
GET {{host}}/health

### register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "name": "Nino Tsereteli",
  "hotel": "Batumi Palace",
  "email": "{{email}}",
  "password": "{{password}}"
}

### login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### me
GET {{host}}/api/auth/me

### logout
POST {{host}}/api/auth/logout

### login with a wrong password -> 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### register with a short password -> 400 with per-field messages
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "name": "Giga",
  "hotel": "Enter your hotel name",
  "email": "test@gmail.com",
  "password": "test12345680"
}

### forgot password -> 204 (link printed in the server log when RESEND_API_KEY is unset)
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{email}}"
}

### reset password -> 200, sets cookie
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{
  "token": "paste-from-the-link",
  "password": "{{password}}"
}

### google sign-in (open in a browser)
GET {{host}}/api/auth/google

### settings
GET {{host}}/api/settings

### rooms
POST {{host}}/api/rooms
Content-Type: application/json

{ "numbers": ["101", "102", "205"] }

### guest bootstrap (token from the room URL)
GET {{host}}/api/guest/{{token}}

### guest request
POST {{host}}/api/guest/{{token}}/requests
Content-Type: application/json

{
  "category": "ac",
  "urgency": "high",
  "language": { "name": "Arabic", "native": "العربية", "code": "AR", "dir": "rtl", "base": "ar" },
  "text": "المكيف لا يعمل",
  "translations": { "en": "The AC is not working" }
}

### desk inbox
GET {{host}}/api/requests

### desk reply
POST {{host}}/api/requests/1/reply
Content-Type: application/json

{ "text": "On our way", "lang": "en", "translations": { "ar": "نحن في الطريق" } }

### team
GET {{host}}/api/team

### analytics
GET {{host}}/api/analytics?range=7d
