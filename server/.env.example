NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000
# Comma-separated when the app is reachable on more than one origin (see `pnpm dev:lan`).
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SAMESITE=lax

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=roomcall

# openssl rand -base64 32
JWT_SECRET=

# Google Cloud console -> OAuth client (web). Authorised redirect URI:
# {API_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave empty in development: reset links are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=RoomCall <onboarding@resend.dev>

# Free text between guests and the desk is translated by Claude when this key
# is set. Without it the server falls back to MyMemory, a free public API with
# a small daily quota (about 5,000 characters, or 50,000 with MYMEMORY_EMAIL).
# TRANSLATOR=off disables translation entirely.
ANTHROPIC_API_KEY=
TRANSLATOR=auto
MYMEMORY_EMAIL=
